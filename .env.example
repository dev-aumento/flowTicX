# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=dev-secret-change-in-production
AUTH_DISABLED=false

# Optional: absolute API origin when the web UI is hosted separately
# (leave empty for same-origin). Example:
# VITE_API_URL=https://your-api.example.com

# Google "Continue with Google" on the login page.
# Create a Web application OAuth client in Google Cloud and allow this site's origin.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Set true to persist data in MongoDB Atlas.
USE_DATABASE=true

# ── MongoDB (required when USE_DATABASE=true) ───────────────────
# MONGODB_CLUSTER_HOST=flowtics.zcz6jtj.mongodb.net
# MONGODB_STANDARD_HOSTS=ac-rkifvwg-shard-00-00.zcz6jtj.mongodb.net:27017,ac-rkifvwg-shard-00-01.zcz6jtj.mongodb.net:27017,ac-rkifvwg-shard-00-02.zcz6jtj.mongodb.net:27017
# MONGODB_USER=flowtics_aumento
# MONGODB_PASSWORD=
# MONGODB_DB_NAME=tracker_app
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/tracker_app?retryWrites=true&w=majority
# DATABASE_URL=

# ── Client portal sign-in code email ────────────────────────────
# When these are set, the 6-digit code is emailed to the client.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="AASO <noreply@example.com>"
